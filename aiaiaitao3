-- Vòng tròn / chữ thập niệm tâm giữa màn hình (Scale được bằng Set* để menu chỉnh)
function S.MakeCrosshair(ov, opts)
    opts = opts or {}
    if not ov then return nil end
    local color  = opts.Color  or Color3.fromRGB(90, 240, 130)
    local radius = math.max(2, tonumber(opts.Radius or opts.Size) or 9)   -- Radius = bán kính
    local thick  = math.max(1, tonumber(opts.Thickness) or 2)
    local gap    = math.max(0, tonumber(opts.Gap) or 5)
    local style  = tostring(opts.Style or "circle")   -- circle | cross | dot | box
    local d = radius * 2

    local root = New("Frame", {
        Name = "BCCrosshair", AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, d + gap * 2 + thick, 0, d + gap * 2 + thick),
        BackgroundTransparency = 1, BorderSizePixel = 0,
    }, ov)

    local parts = {}
    if style == "circle" or style == "box" then
        local ring = New("Frame", {
            Name = "Ring", AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, d, 0, d),
            BackgroundTransparency = 1, BorderSizePixel = 0,
        }, root)
        if style == "circle" then Corner(ring, UDim.new(0, math.floor(radius))) end
        parts[#parts+1] = Stroke(ring, color, thick)
    elseif style == "cross" then
        for i, sz in ipairs({
            {X = UDim.new(0, thick), Y = UDim.new(1, 0)},       -- dọc
            {X = UDim.new(1, 0), Y = UDim.new(0, thick)},       -- ngang
        }) do
            local line = New("Frame", {
                Name = "Line" .. i, BackgroundColor3 = color, BorderSizePixel = 0,
                Size = UDim2.new(sz.X, sz.Y), AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
            }, root)
            -- chừa khoảng trống giữa tâm (gap) bằng cách cắt 2 đầu: dùng 4 đoạn ngắn
            line.Visible = false
            for _, off in ipairs({{-1, 0}, {1, 0}, {0, -1}, {0, 1}}) do
                local seg = New("Frame", {
                    Name = "Seg", BackgroundColor3 = color, BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
                    Size = (i == 1) and UDim2.new(0, thick, 0, radius) or UDim2.new(0, radius, 0, thick),
                }, root)
                seg.Position = UDim2.new(
                    0.5 + off[1] * (gap / 2 + (i == 1 and 0 or radius / 2)),
                    0, 0.5 + off[2] * (gap / 2 + (i == 1 and radius / 2 or 0)), 0)
                parts[#parts+1] = seg
            end
        end
    end
    local dot = New("Frame", {
        Name = "Dot", BackgroundColor3 = color, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, thick, 0, thick),
    }, root)
    Corner(dot, UDim.new(1, 0))

    local h = { Root = root, Dot = dot, Parts = parts }
    function h.SetVisible(self, v) pcall(function() self.Root.Visible = not not v end) end
    function h.SetColor(self, c)
        pcall(function() self.Dot.BackgroundColor3 = c end)
        for _, p in ipairs(self.Parts) do
            pcall(function() if p.IsA("UIStroke") then p.Color = c else p.BackgroundColor3 = c end end)
        end
    end
    function h.SetSize(self, r)
        r = math.max(2, tonumber(r) or 9)
        pcall(function()
            self.Root.Size = UDim2.new(0, r * 2 + gap * 2 + thick, 0, r * 2 + gap * 2 + thick)
            local ring = self.Root:FindFirstChild("Ring")
            if ring then
                ring.Size = UDim2.new(0, r * 2, 0, r * 2)
                local co = ring:FindFirstChildOfClass("UICorner")
                if co then co.CornerRadius = UDim.new(0, math.floor(r)) end
            end
        end)
    end
    function h.Destroy(self) pcall(function() self.Root:Destroy() end) end
    return h
end

