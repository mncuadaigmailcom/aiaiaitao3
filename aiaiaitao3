        if editorFrame then editorFrame.Visible = false end
    end
    errorCloseBtn.Activated:Connect(function() errorFrame.Visible = false end)

    local function ClearHost()
        local killed = {}
        for _, child in ipairs(embedHost:GetChildren()) do
            killed[child] = true
            pcall(function() child:Destroy() end)
        end
        -- Bản cũ quên dọn _G.BananaCatHub_EmbedHosts: mảng này phình vô hạn theo số lần
        -- bấm "Chạy Script", và vòng lặp resize cứ phải duyệt qua toàn bộ host đã chết.
        if _G.BananaCatHub_EmbedHosts then
            local kept = {}
            for _, h in ipairs(_G.BananaCatHub_EmbedHosts) do
                if h and h.Parent and not killed[h] then table.insert(kept, h) end
            end
            _G.BananaCatHub_EmbedHosts = kept
        end
    end

    -- Khoá chống bấm đúp: mỗi lần bấm là một lần ClearHost + loadstring + spawn,
    -- bấm liên tục sẽ chạy chồng nhiều bản script cùng lúc.
    local featureRunning = false

    runFeatureBtn.Activated:Connect(function()
        if featureRunning then
