-- =====================================================
--  DEEPSEEK BLOX FRUITS AUTO FARM SCRIPT
--  Hãy dùng trong executor (Krnl, Synapse, ...)
--  Cấu hình nhanh ở phần Config
-- =====================================================

local Config = {
    -- Bật/tắt toàn bộ script
    Enabled = true,

    -- Chọn chế độ quái:
    -- true  = tự tìm mọi mob có máu trong bán kính
    -- false = chỉ farm quái có tên trong MobNames
    AutoFindMobs = true,
    MobNames = {
        "Bandit", "Marine", "Pirate", "SkyBandit", "God's Guard",
        "Vice Admiral", "Fishman", "Ice Warrior", "Desert Pirate",
        "Mummy", "Pharaoh", "Cursed Captain", "Vampire", "Werewolf",
        "Snow Bandit", "Viking", "Pirate Ruffian", "Pirate Raider",
        "Pirate Millionaire", "Pirate Billionaire", "Marine Admiral"
    },

    -- Bán kính tìm quái (tính từ nhân vật)
    SearchRadius = 300,

    -- Di chuyển bằng teleport hay chạy bộ
    Teleport = true,

    -- Tự hồi máu
    AutoHeal = true,
    HealThreshold = 0.3,      -- hồi khi máu dưới 30%

    -- Tự nâng cấp stats
    AutoStats = true,
    StatsInterval = 20,       -- mỗi X giây
    StatsPriority = { "Melee", "Defense", "Sword" },

    -- Tự nhặt trái ác quỷ
    AutoCollectFruit = true,

    -- Tấn công liên tục nhiều lần trong một nhịp
    FastAttack = true,
}

-- =====================================================
--  KHÔNG CHẠM VÀO PHẦN DƯỚI NẾU KHÔNG BIẾT MÌNH ĐANG LÀM GÌ
-- =====================================================

local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local humanoid = char:WaitForChild("Humanoid")
local root = char:WaitForChild("HumanoidRootPart")
local VirtualInput = game:GetService("VirtualInputManager")

-- Hàm tìm quái gần nhất
local function getNearestMob()
    local nearest = nil
    local minDist = Config.SearchRadius

    for _, v in ipairs(workspace:GetDescendants()) do
        if not v:IsA("Model") or v == char then
            continue
        end

        local hum = v:FindFirstChild("Humanoid")
        local hrp = v:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then
            continue
        end

        -- Nếu không tự tìm, so tên với danh sách
        if not Config.AutoFindMobs and not table.find(Config.MobNames, v.Name) then
            continue
        end

        local dist = (hrp.Position - root.Position).Magnitude
        if dist < minDist then
            minDist = dist
            nearest = v
        end
    end

    return nearest
end

-- Di chuyển đến mục tiêu
local function moveToMob(mob)
    local targetPos = mob.HumanoidRootPart.Position
    if Config.Teleport then
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 0, 5))
    else
        humanoid:MoveTo(targetPos)
    end
end

-- Tấn công: tool + kỹ năng
local function attack()
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
        if Config.FastAttack then
            task.wait(0.05)
            tool:Activate()
        end
    end

    -- Gửi phím kỹ năng (Z, X, C, V)
    local keys = {
        Enum.KeyCode.Z,
        Enum.KeyCode.X,
        Enum.KeyCode.C,
        Enum.KeyCode.V
    }

    for _, key in ipairs(keys) do
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(0.08)
        VirtualInput:SendKeyEvent(false, key, false, game)
        task.wait(0.08)
    end
end

-- Hồi máu bằng thức ăn trong túi + chạy xa
local function heal()
    -- Tránh xa đám đông
    root.CFrame = root.CFrame * CFrame.new(0, 0, 30)

    -- Tìm đồ ăn trong backpack
    local backpack = player.Backpack
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and string.match(item.Name, "Meat|Apple|Bread|Fish|Pineapple") then
            item.Parent = char
            task.wait(0.1)
            item:Activate()
            task.wait(0.1)
            break
        end
    end
end

-- Nâng cấp stats
local function upgradeStats()
    for _, remote in ipairs(game.ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteFunction") and string.find(remote.Name, "Stats|Level|Point") then
            for _, stat in ipairs(Config.StatsPriority) do
                remote:InvokeServer("AddPoint", stat)
                task.wait(0.05)
            end
            break
        end
    end
end

-- Nhặt trái ác quỷ rơi
local function collectFruit()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Part") and string.find(v.Name:lower(), "fruit") then
            local dist = (v.Position - root.Position).Magnitude
            if dist < Config.SearchRadius then
                root.CFrame = CFrame.new(v.Position + Vector3.new(0, 3, 0))
                task.wait(0.1)
            end
        end
    end
end

-- =====================================================
--  VÒNG LẶP CHÍNH
-- =====================================================

-- Farm quái
task.spawn(function()
    while true do
        task.wait(0.1)
        if not Config.Enabled then
            continue
        end

        local mob = getNearestMob()
        if mob then
            moveToMob(mob)
            attack()
        end

        if Config.AutoCollectFruit then
            collectFruit()
        end
    end
end)

-- Tự hồi máu
task.spawn(function()
    while true do
        task.wait(0.2)
        if Config.AutoHeal and humanoid.Health / humanoid.MaxHealth < Config.HealThreshold then
            heal()
        end
    end
end)

-- Tự nâng cấp stats
task.spawn(function()
    while true do
        task.wait(Config.StatsInterval)
        if Config.AutoStats then
            upgradeStats()
        end
    end
end)

-- In trạng thái
print("[DeepSeek] Script đã được kích hoạt. Hãy dùng có trách nhiệm.")
