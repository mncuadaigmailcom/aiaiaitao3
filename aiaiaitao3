    if not S.locEspAll and not S.locEspSingle then
        if next(locEspObjs) then
            for loc, obj in pairs(locEspObjs) do
                if obj.Att then obj.Att:Destroy() end
                if obj.BB then obj.BB:Destroy() end
            end
            locEspObjs = {}
        end
        return
    end

    local r = Root()
    local activeLocs = {}
    if S.locEspAll then
        for _, loc in ipairs(savedLocations) do table.insert(activeLocs, loc) end
    elseif S.locEspSingle and S.locTarget then
        table.insert(activeLocs, S.locTarget)
    end

    for loc, obj in pairs(locEspObjs) do
        local stillActive = false
        for _, aloc in ipairs(activeLocs) do
            if aloc == loc then stillActive = true break end
        end
        if not stillActive then
            if obj.Att then obj.Att:Destroy() end
            if obj.BB then obj.BB:Destroy() end
            locEspObjs[loc] = nil
        end
    end

    for _, loc in ipairs(activeLocs) do
