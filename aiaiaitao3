-- ==================== FLY TO PLAYER SYSTEM (TỰ ĐỘNG NOCLIP) ====================
local flyToConn = nil
local autoNoClipActive = false

local function StopFlyTo()
    if flyToConn then
        flyToConn:Disconnect()
        flyToConn = nil
    end
    local h = Hum()
    if h then h.PlatformStand = false end
    S.flyToTarget = nil

    if autoNoClipActive and S.noClip then
        S.noClip = false
        if noclipBtn then
            noclipBtn.Text = "🚶 NoClip: TẮT"
            noclipBtn.BackgroundColor3 = C.GRAY
        end
        DisNC()
        autoNoClipActive = false
    end
end

local function StartFlyTo(targetPlayer)
    if S.flying then S.flying = false; TogFly() end
    if S.flyRun then S.flyRun = false; StopFlyRun() end
    StopFlyTo()

    if not targetPlayer then return end

    S.flyToTarget = targetPlayer
    local h = Hum()
    if h then h.PlatformStand = true end

    if not S.noClip then
        S.noClip = true
        if noclipBtn then
            noclipBtn.Text = "🚶 NoClip: BẬT"
            noclipBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
        end
        EnNC()
        autoNoClipActive = true
    else
        autoNoClipActive = false
    end

    flyToConn = RunService.RenderStepped:Connect(function(dt)
        local r = Root()
        local h = Hum()
        if not r or not h or not S.flyToTarget or not S.flyToTarget.Parent then
            StopFlyTo()
            if RebuildTPList then RebuildTPList() end
            return
        end

        local targetChar = S.flyToTarget.Character
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local targetR = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

        if not targetR or not targetHum or targetHum.Health <= 0 then
            r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            return
        end

        local dir = (targetR.Position - r.Position)
        local dist = dir.Magnitude
        local stopDist = 4

        if dist > stopDist then
            local moveAmount = math.min(dist - stopDist, S.flyToSpeed * dt)
            local newPos = r.Position + dir.Unit * moveAmount
            r.CFrame = CFrame.lookAt(newPos, targetR.Position)
        else
            r.CFrame = CFrame.new(r.Position, targetR.Position)
            r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

