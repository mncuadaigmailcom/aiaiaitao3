-- VÒNG LẶP XỬ LÝ TỰ ĐỘNG NGẮM (AIMBOT CIRCLE)
local function GetClosestPlayerInCircle()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local centerScreen = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local radius = S.xrayCircleSize / 2
    local closestTarget = nil
    local shortestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local hum = p.Character.Humanoid
            if hum.Health > 0 then
                local targetPos = p.Character.HumanoidRootPart.Position
                local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)

                if onScreen then
                    local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    if distToCenter <= radius then
                        if distToCenter < shortestDist then
                            shortestDist = distToCenter
                            closestTarget = p.Character.HumanoidRootPart
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

RunService.RenderStepped:Connect(function()
    if S.aimLock and S.xrayCircle then
        local target = GetClosestPlayerInCircle()
        local camera = workspace.CurrentCamera
        if target and camera then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, target.Position)
        end
    end
end)


