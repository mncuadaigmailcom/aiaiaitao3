local function EnNC()
    if ncConn then ncConn:Disconnect() end
    ncConn = RunService.Stepped:Connect(function()
        if not S.noClip then return end
        local c = GetChar()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end
    end)
end

