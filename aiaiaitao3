-- ==================== TOGGLE MENU & DRAG ====================
local function ToggleMainFrame()
    -- (a) CHỐNG BẤM 1 LẦN MÀ TOGGLE 2 LẦN. Nút 🍌 có tới 2 đường kích hoạt:
    --     UserInputService.InputEnded (khi đang bật kéo-thả) và togBtn.Activated.
    --     Nếu cờ S.togDragging còn sót từ lần kéo trước thì CẢ HAI cùng chạy
    --     -> Visible đổi 2 lần -> trở về y như cũ -> "bấm hiện mà menu không hiện".
    local now = tick()
    if S.lastToggle and (now - S.lastToggle) < 0.1 then return end
    S.lastToggle = now

    local show = not main.Visible
    main.Visible = show
    togBtn.Text = show and "✕" or "🍌"
    -- Hiện menu thì đẩy hub lên trên cùng: nếu có ScreenGui của script đang phủ lên
    -- nút 🍌 / khung menu thì cú bấm này dẹp nó xuống dưới.
    if show then RaiseHub() end

    -- (b) KÉO MENU VỀ TRONG TẦM NHÌN. Menu có thể bị kéo lê (nút 🔓) ra hẳn ngoài
    --     màn hình, hoặc bị script lạ ghi đè Position. Lúc đó Visible = true nhưng
    --     người dùng KHÔNG THẤY GÌ CẢ. Phải set Visible trước rồi mới đo Absolute*,
    --     vì khung đang ẩn thì số đo có thể chưa cập nhật.
    if show then
        local okVp, vp = pcall(function() return camera.ViewportSize end)
        local vpX = (okVp and vp and vp.X) or 0
        local vpY = (okVp and vp and vp.Y) or 0
        if vpX < 200 or vpY < 200 then vpX, vpY = 1280, 720 end

        local sz = main.AbsoluteSize
        local w = (sz and sz.X) or 0
        local h = (sz and sz.Y) or 0
        if w < 40 then w = math.max(main.Size.X.Offset, 440) end
        if h < 40 then h = math.max(main.Size.Y.Offset, 260) end

        local ap = main.AbsolutePosition
        local px = (ap and ap.X) or 0
        local py = (ap and ap.Y) or 0

        -- Chỉ dời khi menu thật sự trôi ra ngoài (chừa 60px để còn nắm được titlebar)
        local nx, ny = px, py
        if px + w < 60 then nx = vpX - w - 20 end
        if px > vpX - 60 then nx = 20 end
        if py + h < 60 then ny = vpY - h - 20 end
        if py > vpY - 60 then ny = 20 end

        if nx ~= px or ny ~= py then
            main.Position = UDim2.new(
                0, math.clamp(math.floor(nx), 0, math.max(0, math.floor(vpX - w))),
                0, math.clamp(math.floor(ny), 0, math.max(0, math.floor(vpY - h)))
            )
        end
    end
end

