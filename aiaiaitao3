-- ĐẨY HUB LÊN TRÊN CÙNG. DisplayOrder=100 là đủ với đa số script, nhưng có script
-- đặt DisplayOrder cho ScreenGui của nó cao hơn -> hub lại bị che. Hàm này soi tất cả
-- ScreenGui anh-em trong cùng parent và đặt hub cao hơn cái cao nhất.
-- Được gọi: lúc khởi động, mỗi lần bấm 🍌 hiện menu, và sau mỗi lần nhúng GUI.
local function RaiseHub()
    pcall(function()
        local par = gui.Parent
        if not par then return end
        local top = 0
        for _, g in ipairs(par:GetChildren()) do
            if g ~= gui and g:IsA("ScreenGui") then
                local d = tonumber(g.DisplayOrder)
                if d and d > top then top = d end
            end
        end
        gui.DisplayOrder = math.max(100, top + 1)
    end)
end
RaiseHub()

