local espGui = New("ScreenGui", {
    Name = "ExMenu_ESP",
    ResetOnSpawn = false,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, targetGui)

local activeESPs = {}

local function RemovePlayerESP(p)
    if activeESPs[p] then
        if activeESPs[p].HL then activeESPs[p].HL:Destroy() end
        if activeESPs[p].BB then activeESPs[p].BB:Destroy() end
        if activeESPs[p].Thread then task.cancel(activeESPs[p].Thread) end
        activeESPs[p] = nil
    end
end

local function ClearAllESP()
    for p, _ in pairs(activeESPs) do
        RemovePlayerESP(p)
    end
    activeESPs = {}
end

local function CreatePlayerESP(p)
    RemovePlayerESP(p)

    if not S.esp or p == player then return end
    if S.soloTrack and p ~= S.soloTarget then return end

    local pChar = p.Character
    if not pChar then return end

    local rPart = pChar:WaitForChild("HumanoidRootPart", 3)
    local hum = pChar:WaitForChild("Humanoid", 3)

    if not rPart or not hum then return end

    if friendCache[p.UserId] == nil then
        task.spawn(function()
            local ok, res = pcall(function() return player:IsFriendsWith(p.UserId) end)
            if ok then friendCache[p.UserId] = res else friendCache[p.UserId] = false end
        end)
    end

    local hl = Instance.new("Highlight")
    hl.Name = p.Name .. "_HL"
    hl.Adornee = pChar
    hl.FillColor = Color3.fromRGB(0, 255, 100)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineTransparency = 0
    hl.Parent = espGui

    local bb = Instance.new("BillboardGui")
    bb.Name = p.Name .. "_BB"
    bb.Adornee = rPart
    bb.Size = UDim2.new(0, 150, 0, 40)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espGui

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(0, 255, 100)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextStrokeTransparency = 0.2
    lbl.Parent = bb

    local thread = task.spawn(function()
        local wasDown = false
        local downStart = 0

        while S.esp and pChar and pChar.Parent and hum and hum.Parent do
            if S.soloTrack and p ~= S.soloTarget then
                break
            end

            local r = Root()
            local state = hum:GetState()

            if state == Enum.HumanoidStateType.Dead then
                break
            end

            local isDowned = hum.PlatformStand or hum.Health <= 0
            local isFriend = friendCache[p.UserId] or false

            if isDowned and not wasDown then
                wasDown = true
                downStart = tick()
            elseif not isDowned and wasDown then
                wasDown = false
                downStart = 0
            end

            local stateText = ""
            if isDowned then
                local elapsed = tick() - downStart
                local mins = math.floor(elapsed / 60)
                local secs = math.floor(elapsed % 60)
                local timeStr = string.format("%02d:%02d", mins, secs)
                stateText = " [☠️ Hạ ngục: " .. timeStr .. "]"

                if isFriend then
                    hl.FillColor = Color3.fromRGB(138, 43, 226)
                    hl.OutlineColor = Color3.fromRGB(200, 150, 255)
                    lbl.TextColor3 = Color3.fromRGB(200, 150, 255)
                else
                    hl.FillColor = Color3.fromRGB(200, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 100, 100)
                    lbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
            else
                if isFriend then
                    hl.FillColor = Color3.fromRGB(255, 105, 180)
                    hl.OutlineColor = Color3.fromRGB(255, 182, 193)
                    lbl.TextColor3 = Color3.fromRGB(255, 182, 193)
                else
                    hl.FillColor = Color3.fromRGB(0, 255, 100)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    lbl.TextColor3 = Color3.fromRGB(0, 255, 100)
                end
            end

            local friendText = isFriend and " [💗 Bạn Bè]" or ""
            if r then
                local dist = math.round((r.Position - rPart.Position).Magnitude)
                lbl.Text = string.format("%s%s%s\n❤️ %d/%d | 📏 %dm", p.Name, friendText, stateText, math.round(hum.Health), math.round(hum.MaxHealth), dist)
            else
                lbl.Text = string.format("%s%s%s\n❤️ %d/%d | 📏 --m", p.Name, friendText, stateText, math.round(hum.Health), math.round(hum.MaxHealth))
            end
            task.wait(0.2)
        end
        RemovePlayerESP(p)
    end)

    activeESPs[p] = {HL = hl, BB = bb, Thread = thread}
end

local function HookPlayer(p)
    if p == player then return end

    p.CharacterAdded:Connect(function()
        if S.esp then
            task.wait(0.5)
            CreatePlayerESP(p)
        end
    end)

    p.CharacterRemoving:Connect(function()
        RemovePlayerESP(p)
    end)

    if p.Character and S.esp then
        CreatePlayerESP(p)
    end
end

local function UpdateESP()
    ClearAllESP()
    if not S.esp then return end

    if S.soloTrack then
        if S.soloTarget then
            CreatePlayerESP(S.soloTarget)
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                CreatePlayerESP(p)
            end
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do HookPlayer(p) end

Players.PlayerAdded:Connect(function(p)
    HookPlayer(p)
    if S.esp then
        task.spawn(function()
            local char = p.Character or p.CharacterAdded:Wait()
            task.wait(0.5)
            if S.esp and char and char.Parent then
                CreatePlayerESP(p)
            end
        end)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if S.soloTarget == p then
        S.soloTarget = nil
        if S.soloTrack then UpdateESP() end
    end
    RemovePlayerESP(p)
    friendCache[p.UserId] = nil
    if RebuildTPList then RebuildTPList() end
end)


-- ==================== CODE EXECUTION ====================
local function ExecOnce(code, name)
    if #name > 0 then print("👤 Chạy bởi:", name) end
    return pcall(function()
        local fn, err = loadstring(code)
        if not fn then error(err) end
        fn()
    end)
end

local function Cancel()
    cancelled = true
    if curThread then task.cancel(curThread); curThread = nil end
    if curIndicator then curIndicator.BackgroundColor3 = C.BLUE; curIndicator = nil end
end

local function RunCode(code, name, ind, times, delay)
    Cancel()
    if #code == 0 then return false, "⚠️ Vui lòng nhập code!" end
    cancelled = false
    if ind then curIndicator = ind; ind.BackgroundColor3 = C.RED end
    local okC, failC = 0, 0
    curThread = task.spawn(function()
        for i = 1, times do
            if cancelled then break end
            if i > 1 and delay > 0 then
                local e = 0
                while e < delay do
                    if cancelled then break end
                    task.wait(0.1)
                    e += 0.1
                end
                if cancelled then break end
            end
            local ok, err = ExecOnce(code, name)
            if ok then okC += 1 else failC += 1; warn("❌ Lần", i, err) end
        end
        totalRuns += okC + failC
        if ind then ind.BackgroundColor3 = C.GREEN; if curIndicator == ind then curIndicator = nil end end
        curThread = nil
    end)
    return true, nil
end

