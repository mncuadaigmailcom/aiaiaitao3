local function Label(parent, text, y)
    return New("TextLabel", {
        Size=UDim2.new(1,-16,0,14), Position=UDim2.new(0,8,0,y or 0),
        Text=text, BackgroundTransparency=1, TextColor3=Color3.fromRGB(60,60,60),
