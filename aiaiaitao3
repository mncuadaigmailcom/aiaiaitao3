-- (featureTabs / featureTabIndex đã khai báo ở ĐẦU file để khối lưu trữ dùng chung.
--  KHÔNG khai báo lại ở đây, nếu không sẽ tạo biến local mới che mất biến cũ
--  và danh sách tab tính năng sẽ không bao giờ được ghi xuống đĩa.)

local function NormalizeCode(c)
    if type(c) ~= "string" then return "" end
    c = c:gsub("^%s+", ""):gsub("%s+$", "")
    if c:match("^https?://") then
        return 'loadstring(game:HttpGet("'..c..'"))()'
    end
    return c
end

-- GUI của CHÍNH Roblox nằm trong CoreGui. KHÔNG BAO GIỜ được "nhúng" mấy cái này vào hub,
-- nếu không sẽ phá HUD / chat / backpack / thông báo của trò chơi.
local CORE_GUI_SKIP = {
    RobloxGui = true, TopBarIconController = true, Chat = true, ExperienceChat = true,
    Backpack = true, PlayerList = true, VoiceChat = true, VoiceChatExperienceUI = true,
    RthroNotifications = true, RobloxPromptGui = true, CoreScriptErrorReporting = true,
    PurchasePrompt = true, LoadingScreen = true, LoadingUI = true, ReportAbuseMenu = true,
    AvatarContextMenu = true, Notifications = true, ScreenGuiOverlay = true,
    VRMaster = true, PlayerEmotesUI = true, SelfView = true, MicControl = true,
}

local function ScanNewGuis(beforeGuis)
    local found = {}
    local function scan(container)
        if not container then return end
        for _, g in ipairs(container:GetChildren()) do
            if not beforeGuis[g] then
                beforeGuis[g] = true
                if not CORE_GUI_SKIP[g.Name] then
                    table.insert(found, g)
                end
            end
        end
    end
    scan(playerGui)
    scan(targetGui)
    pcall(function()
        local cg = game:GetService("CoreGui")
        if cg and cg ~= targetGui then scan(cg) end
    end)
    return found
end

-- MẶC ĐỊNH CHỈ XỬ LÝ ĐÚNG OBJECT ĐƯỢC ĐƯA VÀO, KHÔNG ĐỆ QUY XUỐNG CON CHÁU.
-- Bản v4.3/v4.4 đệ quy toàn cây và ép Size=(1,0,1,0) + Position=(0,0,0,0) lên MỌI
-- Frame/ScrollingFrame/CanvasGroup -> sidebar, panel, nút của GUI nhúng bị chồng hết
-- lên nhau ở góc trên-trái thành một đống không bấm được. Đó là lý do "chạy tính năng
-- xong thấy GUI vỡ/lỗi". Muốn lấy lại hành vi cũ thì bật Store.deepStretch.
local function ForceStretchToParent(obj, deep)
    if deep == nil then deep = (Store.deepStretch == true) end
    if not obj then return end
    pcall(function()
        if obj:IsA("GuiObject") then
            if obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("CanvasGroup") then
                local s = obj.Size
                if s.X.Scale < 0.9 and s.X.Offset > 0 then
                    obj.Size = UDim2.new(1, 0, s.Y.Scale > 0 and s.Y.Scale or 1, 0)
                end
                if obj.Position.X.Offset ~= 0 or obj.Position.Y.Offset ~= 0 then
                    obj.Position = UDim2.new(0, 0, 0, 0)
                end
            end
        end
    end)
    if deep then
        for _, child in ipairs(obj:GetChildren()) do
            ForceStretchToParent(child, deep)
        end
    end
end

local function RunFeatureScript(code, name, containerFrame, indicator, statusLabel, onError, onDone)
    -- onError(title, msg) : hiển thị lỗi ĐẦY ĐỦ (fStatus chỉ 180px nên bị cắt cụt)
    -- onDone()            : báo đã xong, để nút "Chạy Script" bỏ khoá chống bấm đúp
    local function setStatus(text, color)
        if statusLabel then statusLabel.Text = text end
        if indicator and color then indicator.BackgroundColor3 = color end
    end
    local doneCalled = false
    local function finish()
        if doneCalled then return end
        doneCalled = true
        if onDone then pcall(onDone) end
    end

    if type(code) ~= "string" or #code == 0 then
        setStatus("⚠️ Vui lòng nhập code!", C.GRAY)
        finish()
        return false, "empty"
    end

    code = NormalizeCode(code)
    setStatus("⏳ Đang biên dịch...", C.RED)

    -- ===== 1) BIÊN DỊCH TRƯỚC, NGOÀI MỌI THREAD =====
    -- Bản cũ nhét loadstring vào trong pcall rồi error() lại, nên lỗi cú pháp bị bọc
    -- thêm một lớp và bị cắt cụt trên fStatus -> người dùng không biết lỗi ở đâu.
    local fn, lerr = loadstring(code)
    if not fn then
        setStatus("❌ Lỗi cú pháp — xem chi tiết", C.RED)
        warn("[BananaCatHub] loadstring thất bại: " .. tostring(lerr))
        if onError then
            pcall(onError, "❌ Lỗi cú pháp — script \"" .. tostring(name) .. "\" không biên dịch được",
                  tostring(lerr) .. "\n\n(Check lại: thiếu end / dấu ngoặc, string chưa đóng, "
                  .. "dán code bị mất dòng, hoặc executor không hỗ trợ cú pháp đó.)")
        end
        finish()
        return false, tostring(lerr)
    end

    -- ===== 2) CHỤP ẢNH GUI TRƯỚC KHI CHẠY =====
    local beforeGuis = {}
    local function snap(container)
        if not container then return end
        for _, g in ipairs(container:GetChildren()) do beforeGuis[g] = true end
    end
    snap(playerGui)
    snap(targetGui)
    pcall(function()
        local cg = game:GetService("CoreGui")
        if cg and cg ~= targetGui then snap(cg) end
    end)

    setStatus("⏳ Đang thực thi...", C.RED)

    -- ===== 3) CHẠY SCRIPT TRÊN THREAD RIÊNG — ĐÂY LÀ BUG CHÍNH =====
    -- Bản cũ gọi fn() ĐỒNG BỘ ngay trong handler của nút bấm, rồi mới tới vòng quét GUI.
    -- Mà script dạng "Auto Farm / Fly / Speed" (đúng mấy cái ô code gợi ý) gần như LUÔN
    -- kết thúc bằng `while true do task.wait(1) ... end` => fn() KHÔNG BAO GIỜ return.
    -- Hậu quả: status kẹt "⏳ Đang thực thi..." vĩnh viễn, GUI không bao giờ được nhúng
    -- (tab trống trơn => tưởng là "lỗi"), và thread của nút bấm bị chiếm cứng.
    local scriptErr, scriptDone = nil, false
    task.spawn(function()
        local okRun, errRun = pcall(fn)
        scriptDone = true
        if not okRun then
            scriptErr = errRun
            warn("[BananaCatHub] Feature script error: " .. tostring(errRun))
        end
    end)

    -- ===== 4) QUÉT + NHÚNG GUI, CHẠY SONG SONG VỚI SCRIPT =====
    task.spawn(function()
        local newGuis = {}
        -- Quét dày (0.05s) và DỪNG NGAY khi thấy GUI, nên với script bình thường cửa sổ
        -- thực tế chỉ vài chục ms. Trần 6s là để bắt được GUI mà script tạo MUỘN
        -- (sau task.wait / sau HttpGet / trong callback) — mấy cái đó nếu không bắt được
        -- sẽ nằm trôi nổi trong CoreGui và vẽ đè lên hub.
        -- Việc loại trừ UI của chính trò chơi do CORE_GUI_SKIP đảm nhiệm.
        local guardReleased = false
        for i = 1, 120 do
            task.wait(0.05)
            local found = ScanNewGuis(beforeGuis)
            for _, g in ipairs(found) do table.insert(newGuis, g) end
            if #newGuis > 0 or scriptErr then break end
            -- script đã return: nán thêm ~0.2s cho kịp GUI do task.spawn bên trong tạo
            if scriptDone and i >= 4 then break end
            -- Quá ~1,5s mà chưa thấy GUI thì NHẢ KHOÁ để người dùng còn bấm lại được;
            -- vòng quét vẫn chạy tiếp ở nền cho tới trần 6s.
            if not guardReleased and i >= 30 then
                guardReleased = true
                setStatus("🟢 Đang chạy nền, vẫn quét GUI...", C.GREEN)
                finish()
            end
        end

        for _, g in ipairs(newGuis) do
            if g:IsA("ScreenGui") or g:IsA("Folder") then
                for _, existing in ipairs(containerFrame:GetChildren()) do
                    if existing.Name == "Embedded_"..g.Name then
                        existing:Destroy()
                    end
                end

                local host = New("Frame", {
                    Size = UDim2.new(1,0,1,0),
                    Position = UDim2.new(0,0,0,0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 5,
                    Name = "Embedded_"..g.Name,
                    ClipsDescendants = false,
                }, containerFrame)

                for _, child in ipairs(g:GetChildren()) do
                    pcall(function() child.Parent = host end)
                end
                pcall(function() g:Destroy() end)

                -- Chỉ dãn cấp ROOT của GUI nhúng, giữ nguyên layout bên trong.
                -- (Muốn hành vi cũ ép-deep-toàn-cây thì bật "📐 Dãn sâu GUI nhúng".)
                for _, child in ipairs(host:GetChildren()) do
                    ForceStretchToParent(child)
                end

                if not _G.BananaCatHub_EmbedHosts then
                    _G.BananaCatHub_EmbedHosts = {}
                end
                table.insert(_G.BananaCatHub_EmbedHosts, host)
                RaiseHub()   -- ScreenGui mới vừa xuất hiện: đẩy hub lên lại trên cùng
            elseif g:IsA("GuiObject") then
                pcall(function()
                    g.Parent = containerFrame
                    g.ZIndex = 5
                    ForceStretchToParent(g)
                end)
            end
        end

        -- ===== 5) BÁO TRẠNG THÁI THẬT =====
        if scriptErr then
            setStatus("❌ Lỗi khi chạy — xem chi tiết", C.RED)
            if onError then
                pcall(onError, "❌ Lỗi khi chạy script \"" .. tostring(name) .. "\"", tostring(scriptErr))
            end
        elseif #newGuis > 0 then
            setStatus("✅ Đã nhúng " .. #newGuis .. " GUI vào tab", C.GREEN)
        elseif scriptDone then
            setStatus("✅ Hoàn thành!", C.GREEN)
        else
            -- Script còn đang chạy vòng lặp ở nền => KHÔNG phải lỗi, nói rõ ra
            setStatus("🟢 Đang chạy nền...", C.GREEN)
        end
        finish()
    end)

    return true, nil
end

