local bv, bg, fp, cp
local StopFlyRun, TogFlyRun

local function StopFly()
    if bv then bv:Destroy(); bv=nil end
    if bg then bg:Destroy(); bg=nil end
    if fp then fp:Destroy(); fp=nil end
    local h = Hum()
    if h then h.AutoRotate=true; h.PlatformStand=false end
    RunService:UnbindFromRenderStep("Fly")
    mobile.Visible=false
end

local function StopCarpet()
    if cp then cp:Destroy(); cp=nil end
    RunService:UnbindFromRenderStep("Carpet")
    S.carpetY=nil
end

local function CreateCarpet(y)
    local r = Root()
    if not r then return end
    
    if cp then cp:Destroy() end

    local w = S.carpetWidth or 1.5
    local t = S.carpetThickness or 0.2
    local l = S.carpetLength or 1.5

    S.carpetY = y or (r.Position.Y - 3.0 - (t / 2))

    cp = New("Part", {
        Name="Carpet", 
        Size=Vector3.new(w, t, l),
        Transparency=0.9,
        Color=Color3.fromRGB(200,230,255), 
        Material=Enum.Material.SmoothPlastic,
        Anchored=true, 
        CanCollide=true, 
        Friction=1,
        Position=Vector3.new(r.Position.X, S.carpetY, r.Position.Z),
    }, workspace)

    RunService:BindToRenderStep("Carpet", Enum.RenderPriority.Camera.Value - 1, function()
        local curR = Root()
        if not S.carpet or not cp or not curR then return end
        
        local curW = S.carpetWidth or 1.5
        local curT = S.carpetThickness or 0.2
        local curL = S.carpetLength or 1.5

        if cp.Size.X ~= curW or cp.Size.Y ~= curT or cp.Size.Z ~= curL then
            cp.Size = Vector3.new(curW, curT, curL)
        end
        
        cp.CFrame = CFrame.new(curR.Position.X, S.carpetY, curR.Position.Z)

        if S.noClip then
            local standingY = S.carpetY + (curT / 2) + 3.0
            if curR.Position.Y < standingY then
                curR.CFrame = CFrame.new(curR.Position.X, standingY, curR.Position.Z)
                if curR.AssemblyLinearVelocity.Y < 0 then
                    curR.AssemblyLinearVelocity = Vector3.new(curR.AssemblyLinearVelocity.X, 0, curR.AssemblyLinearVelocity.Z)
                end
            end
        end
    end)
end

local function TogFly()
    local r=Root()
    local h=Hum()
    if not r then return end

    if S.flying then
        if S.carpet then StopCarpet(); S.carpet=false end
        if S.flyRun and StopFlyRun then StopFlyRun() end
        bv=New("BodyVelocity",{MaxForce=Vector3.new(4000,4000,4000)},r)
        bg=New("BodyGyro",{MaxTorque=Vector3.new(4000,4000,4000)},r)
        if h then h.AutoRotate=false; h.PlatformStand=true end
        if not fp then
            fp=New("Part",{
                Name="Floor", Size=Vector3.new(6,0.2,6), Transparency=0.7,
                Color=Color3.fromRGB(200,230,255), Material=Enum.Material.Glass,
                Anchored=true, CanCollide=false,
            }, workspace)
        end
        RunService:BindToRenderStep("Fly",1,function()
            local curR = Root()
            local curH = Hum()
            if not S.flying or not curR or not bv then return end
            local d=curH and curH.MoveDirection or Vector3.zero
            local t=curR.CFrame:VectorToWorldSpace(d)
            if t.Magnitude>0 then t=t.Unit end
            local u,dn=VInput()
            local vv=(u and 1 or 0)-(dn and 1 or 0)
            bv.Velocity=(t+Vector3.new(0,vv,0))*S.flySpeed
            bg.CFrame=CFrame.new(curR.Position,curR.Position+workspace.CurrentCamera.CFrame.LookVector)
            fp.Position=curR.Position-Vector3.new(0,3.5,0)
        end)
    else
        StopFly()
    end
    mobile.Visible=S.flying and UserInputService.TouchEnabled
end

local function TogCarpet()
    local r=Root()
    if not r then return end
    if S.carpet then
        if S.flying then S.flying=false; StopFly() end
        CreateCarpet(r.Position.Y - 3.0 - ((S.carpetThickness or 0.2) / 2))
    else
        StopCarpet()
    end
end

