local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local humanoid = char:WaitForChild("Humanoid")
local root = char:WaitForChild("HumanoidRootPart")
local VirtualInput = game:GetService("VirtualInputManager")

-- =====================================================
--  CẤU HÌNH MẶC ĐỊNH (có thể chỉnh trong menu)
-- =====================================================
local Settings = {
    Enabled = false,
    AutoFindMobs = true,
    Teleport = true,
    AutoHeal = true,
    HealThreshold = 30,  -- % máu
    AutoStats = true,
    StatsInterval = 20,
    AutoCollectFruit = true,
    FastAttack = true,
    SearchRadius = 300,
}

-- Danh sách quái nếu AutoFindMobs = false
local MobNames = {
    "Bandit", "Marine", "Pirate", "SkyBandit", "God's Guard",
    "Vice Admiral", "Fishman", "Ice Warrior", "Desert Pirate",
    "Mummy", "Pharaoh", "Cursed Captain", "Vampire", "Werewolf",
    "Snow Bandit", "Viking", "Pirate Ruffian", "Pirate Raider",
    "Pirate Millionaire", "Pirate Billionaire", "Marine Admiral"
}

-- =====================================================
--  HÀM CHÍNH (giống trước, nhưng dùng Settings)
-- =====================================================
local function getNearestMob()
    local nearest = nil
    local minDist = Settings.SearchRadius

    for _, v in ipairs(workspace:GetDescendants()) do
        if not v:IsA("Model") or v == char then continue end
        local hum = v:FindFirstChild("Humanoid")
        local hrp = v:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then continue end

        if not Settings.AutoFindMobs and not table.find(MobNames, v.Name) then continue end

        local dist = (hrp.Position - root.Position).Magnitude
        if dist < minDist then
            minDist = dist
            nearest = v
        end
    end
    return nearest
end

local function moveToMob(mob)
    local targetPos = mob.HumanoidRootPart.Position
    if Settings.Teleport then
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 0, 5))
    else
        humanoid:MoveTo(targetPos)
    end
end

local function attack()
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
        if Settings.FastAttack then
            task.wait(0.05)
            tool:Activate()
        end
    end

    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        VirtualInput:SendKeyEvent(true, key, false, game)
        task.wait(0.08)
        VirtualInput:SendKeyEvent(false, key, false, game)
        task.wait(0.08)
    end
end

local function heal()
    root.CFrame = root.CFrame * CFrame.new(0, 0, 30)
    local backpack = player.Backpack
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and string.match(item.Name, "Meat|Apple|Bread|Fish|Pineapple") then
            item.Parent = char
            task.wait(0.1)
            item:Activate()
            task.wait(0.1)
            break
        end
    end
end

local function upgradeStats()
    for _, remote in ipairs(game.ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteFunction") and string.find(remote.Name, "Stats|Level|Point") then
            remote:InvokeServer("AddPoint", "Melee")
            task.wait(0.05)
            remote:InvokeServer("AddPoint", "Defense")
            task.wait(0.05)
            remote:InvokeServer("AddPoint", "Sword")
            task.wait(0.05)
            break
        end
    end
end

local function collectFruit()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Part") and string.find(v.Name:lower(), "fruit") then
            local dist = (v.Position - root.Position).Magnitude
            if dist < Settings.SearchRadius then
                root.CFrame = CFrame.new(v.Position + Vector3.new(0, 3, 0))
                task.wait(0.1)
            end
        end
    end
end

-- Vòng lặp farm
task.spawn(function()
    while task.wait(0.1) do
        if not Settings.Enabled then continue end

        local mob = getNearestMob()
        if mob then
            moveToMob(mob)
            attack()
        end
        if Settings.AutoCollectFruit then
            collectFruit()
        end
    end
end)

-- Vòng lặp hồi máu
task.spawn(function()
    while task.wait(0.2) do
        if Settings.AutoHeal and (humanoid.Health / humanoid.MaxHealth * 100) < Settings.HealThreshold then
            heal()
        end
    end
end)

-- Vòng lặp stats
task.spawn(function()
    while task.wait(Settings.StatsInterval) do
        if Settings.AutoStats and Settings.Enabled then
            upgradeStats()
        end
    end
end)

